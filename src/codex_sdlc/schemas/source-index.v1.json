{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sdlc.source-index.v1",
  "x-codex-sdlc-hash-exclude": [
    "/artifact_sha256"
  ],
  "type": "object",
  "required": [
    "schema",
    "source_kind",
    "source_projection_sha256",
    "normalization",
    "documents",
    "units",
    "artifact_sha256"
  ],
  "properties": {
    "schema": {
      "const": "sdlc.source-index.v1"
    },
    "source_kind": {
      "enum": [
        "formal",
        "draft"
      ]
    },
    "draft_id": {
      "type": "string",
      "pattern": "^DRAFT-[0-9]{3,}$"
    },
    "source_projection_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "normalization": {
      "const": "utf-8-preserve-source-and-canonical-json-pointer-v1"
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/document"
      }
    },
    "units": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/json_pointer_unit"
          },
          {
            "$ref": "#/$defs/markdown_line_unit"
          }
        ]
      }
    },
    "artifact_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source_kind": {
            "const": "draft"
          }
        },
        "required": [
          "source_kind"
        ]
      },
      "then": {
        "required": [
          "draft_id"
        ]
      },
      "else": {
        "not": {
          "required": [
            "draft_id"
          ]
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "document": {
      "type": "object",
      "required": [
        "document_id",
        "sha256"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "relative_path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "common_unit_properties": {
      "type": "object",
      "properties": {
        "unit_id": {
          "type": "string",
          "pattern": "^(RU|DU|QU|CU)-[0-9]{4,}$"
        },
        "owner": {
          "enum": [
            "requirement",
            "design"
          ]
        },
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "anchor_kind": {
          "enum": [
            "json_pointer",
            "markdown_lines"
          ]
        },
        "section_key": {
          "type": "string"
        },
        "quote": {
          "type": "string"
        },
        "quote_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "classification": {
          "enum": [
            "structural",
            "content"
          ]
        }
      }
    },
    "json_pointer_unit": {
      "type": "object",
      "required": [
        "unit_id",
        "owner",
        "document_id",
        "source_projection_sha256",
        "anchor_kind",
        "json_pointer",
        "section_key",
        "quote",
        "quote_sha256",
        "classification"
      ],
      "properties": {
        "unit_id": {
          "$ref": "#/$defs/common_unit_properties/properties/unit_id"
        },
        "owner": {
          "$ref": "#/$defs/common_unit_properties/properties/owner"
        },
        "document_id": {
          "$ref": "#/$defs/common_unit_properties/properties/document_id"
        },
        "source_projection_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "anchor_kind": {
          "const": "json_pointer"
        },
        "json_pointer": {
          "type": "string"
        },
        "section_key": {
          "$ref": "#/$defs/common_unit_properties/properties/section_key"
        },
        "quote": {
          "$ref": "#/$defs/common_unit_properties/properties/quote"
        },
        "quote_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "classification": {
          "$ref": "#/$defs/common_unit_properties/properties/classification"
        }
      },
      "additionalProperties": false
    },
    "markdown_line_unit": {
      "type": "object",
      "required": [
        "unit_id",
        "owner",
        "document_id",
        "relative_path",
        "document_sha256",
        "anchor_kind",
        "line_start",
        "line_end",
        "section_key",
        "quote",
        "quote_sha256",
        "classification"
      ],
      "properties": {
        "unit_id": {
          "$ref": "#/$defs/common_unit_properties/properties/unit_id"
        },
        "owner": {
          "$ref": "#/$defs/common_unit_properties/properties/owner"
        },
        "document_id": {
          "$ref": "#/$defs/common_unit_properties/properties/document_id"
        },
        "relative_path": {
          "type": "string",
          "minLength": 1
        },
        "document_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "anchor_kind": {
          "const": "markdown_lines"
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        },
        "section_key": {
          "$ref": "#/$defs/common_unit_properties/properties/section_key"
        },
        "quote": {
          "$ref": "#/$defs/common_unit_properties/properties/quote"
        },
        "quote_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "classification": {
          "$ref": "#/$defs/common_unit_properties/properties/classification"
        }
      },
      "additionalProperties": false
    }
  }
}
