{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sdlc.requirement-facts.v1",
  "x-codex-sdlc-hash-exclude": [
    "/artifact_sha256"
  ],
  "type": "object",
  "required": [
    "schema",
    "semantic",
    "semantic_sha256",
    "context_targets",
    "bindings",
    "producer",
    "coverage",
    "artifact_sha256"
  ],
  "properties": {
    "schema": {
      "const": "sdlc.requirement-facts.v1"
    },
    "draft_id": {
      "type": "string",
      "pattern": "^DRAFT-[0-9]{3,}$"
    },
    "semantic": {
      "$ref": "#/$defs/semantic"
    },
    "semantic_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "context_targets": {
      "$ref": "#/$defs/context"
    },
    "bindings": {
      "$ref": "#/$defs/bindings"
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "coverage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/coverage"
      }
    },
    "artifact_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "context": {
      "type": "object",
      "required": [
        "source_projection_sha256",
        "source_index_sha256",
        "requirement_source_sha256",
        "design_source_sha256",
        "questions_sha256",
        "decisions_sha256",
        "context_inputs_sha256"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      }
    },
    "fact": {
      "type": "object",
      "required": [
        "fact_id",
        "category",
        "owner",
        "statement",
        "normalized",
        "certainty",
        "source_refs",
        "decision_refs",
        "ambiguity_id"
      ],
      "properties": {
        "fact_id": {
          "type": "string",
          "pattern": "^RF-[0-9]{4,}$"
        },
        "category": {
          "enum": [
            "goal",
            "actor_scenario",
            "scope",
            "out_of_scope",
            "business_rule",
            "permission",
            "interface",
            "page_behavior",
            "state_transition",
            "error",
            "data_change",
            "acceptance",
            "test_case"
          ]
        },
        "owner": {
          "const": "requirement"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "normalized": {
          "type": "object"
        },
        "certainty": {
          "enum": [
            "confirmed",
            "ambiguous",
            "inferred"
          ]
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "decision_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "ambiguity_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "category": {
                "const": "acceptance"
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "properties": {
              "normalized": {
                "type": "object",
                "required": [
                  "expected"
                ],
                "properties": {
                  "expected": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "actor_scenario"
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "properties": {
              "normalized": {
                "type": "object",
                "required": [
                  "actor",
                  "scenario",
                  "trigger"
                ],
                "properties": {
                  "actor": {
                    "type": "string",
                    "minLength": 1
                  },
                  "scenario": {
                    "type": "string",
                    "minLength": 1
                  },
                  "trigger": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "business_rule"
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "properties": {
              "normalized": {
                "type": "object",
                "required": [
                  "rule"
                ],
                "properties": {
                  "rule": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "data_change"
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "properties": {
              "normalized": {
                "type": "object",
                "required": [
                  "change",
                  "entity"
                ],
                "properties": {
                  "change": {
                    "type": "string",
                    "minLength": 1
                  },
                  "entity": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "error"
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "properties": {
              "normalized": {
                "type": "object",
                "required": [
                  "condition",
                  "result"
                ],
                "properties": {
                  "condition": {
                    "type": "string",
                    "minLength": 1
                  },
                  "result": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "goal"
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "properties": {
              "normalized": {
                "type": "object",
                "required": [
                  "value"
                ],
                "properties": {
                  "value": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "interface"
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "properties": {
              "normalized": {
                "type": "object",
                "required": [
                  "method",
                  "path"
                ],
                "properties": {
                  "method": {
                    "type": "string",
                    "minLength": 1
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "out_of_scope"
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "properties": {
              "normalized": {
                "type": "object",
                "required": [
                  "excluded"
                ],
                "properties": {
                  "excluded": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "page_behavior"
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "properties": {
              "normalized": {
                "type": "object",
                "required": [
                  "action",
                  "page",
                  "result"
                ],
                "properties": {
                  "action": {
                    "type": "string",
                    "minLength": 1
                  },
                  "page": {
                    "type": "string",
                    "minLength": 1
                  },
                  "result": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "permission"
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "properties": {
              "normalized": {
                "type": "object",
                "required": [
                  "action",
                  "direction",
                  "resource",
                  "subject"
                ],
                "properties": {
                  "action": {
                    "type": "string",
                    "minLength": 1
                  },
                  "direction": {
                    "type": "string",
                    "minLength": 1
                  },
                  "resource": {
                    "type": "string",
                    "minLength": 1
                  },
                  "subject": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "scope"
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "properties": {
              "normalized": {
                "type": "object",
                "required": [
                  "included"
                ],
                "properties": {
                  "included": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "state_transition"
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "properties": {
              "normalized": {
                "type": "object",
                "required": [
                  "from",
                  "to",
                  "trigger"
                ],
                "properties": {
                  "from": {
                    "type": "string",
                    "minLength": 1
                  },
                  "to": {
                    "type": "string",
                    "minLength": 1
                  },
                  "trigger": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "test_case"
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "properties": {
              "normalized": {
                "type": "object",
                "required": [
                  "expected",
                  "operation"
                ],
                "properties": {
                  "expected": {
                    "type": "string",
                    "minLength": 1
                  },
                  "operation": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": true
              }
            }
          }
        }
      ]
    },
    "semantic": {
      "type": "object",
      "required": [
        "facts",
        "relations",
        "ambiguities"
      ],
      "properties": {
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        },
        "relations": {
          "type": "array",
          "maxItems": 0
        },
        "ambiguities": {
          "type": "array"
        }
      },
      "additionalProperties": false
    },
    "bindings": {
      "type": "object",
      "required": [
        "origin_refs",
        "formal_refs"
      ],
      "properties": {
        "origin_refs": {
          "type": "array"
        },
        "formal_refs": {
          "type": "array"
        }
      },
      "additionalProperties": false
    },
    "producer": {
      "type": "object",
      "required": [
        "kind",
        "actor_id",
        "run_id"
      ],
      "properties": {
        "kind": {
          "const": "model"
        },
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "coverage": {
      "type": "object",
      "required": [
        "unit_id",
        "fact_ids",
        "status",
        "reason"
      ],
      "properties": {
        "unit_id": {
          "type": "string"
        },
        "fact_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "enum": [
            "covered",
            "non_contractual",
            "ambiguous"
          ]
        },
        "reason": {
          "type": "string"
        },
        "decision_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "approval_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  }
}
