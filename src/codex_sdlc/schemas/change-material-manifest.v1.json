{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "change-material-manifest.v1",
  "title": "变更资料清单合同",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "requirement_id",
    "change_id",
    "workspace_path",
    "materials"
  ],
  "properties": {
    "schema_version": {
      "const": "change-material-manifest.v1"
    },
    "requirement_id": {
      "type": "string",
      "pattern": "^REQ-[0-9]+$"
    },
    "change_id": {
      "type": "string",
      "pattern": "^CHG-[0-9]+$"
    },
    "workspace_path": {
      "type": "string",
      "pattern": "^\\.codex-sdlc/requirements/[^/]+/changes/CHG-[0-9]+$"
    },
    "materials": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/file_material"
          },
          {
            "$ref": "#/$defs/external_material"
          },
          {
            "$ref": "#/$defs/secret_material"
          }
        ]
      }
    }
  },
  "$defs": {
    "material_type": {
      "enum": [
        "requirement",
        "technical-solution",
        "ui-design",
        "api-document",
        "database-document",
        "sample-data",
        "account",
        "environment",
        "field-evidence",
        "other"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^EVT-[0-9]{8}-[0-9]{6,}$"
    },
    "secret_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "identifier",
        "access"
      ],
      "properties": {
        "schema_version": {
          "const": "secret-reference.v1"
        },
        "kind": {
          "enum": [
            "environment-variable",
            "keychain-item",
            "manual-provision"
          ]
        },
        "identifier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:/@-]+$"
        },
        "access": {
          "enum": [
            "runtime-only",
            "manual-only"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "environment-variable"
              }
            }
          },
          "then": {
            "properties": {
              "identifier": {
                "pattern": "^[A-Z_][A-Z0-9_]*$"
              },
              "access": {
                "const": "runtime-only"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "manual-provision"
              }
            }
          },
          "then": {
            "properties": {
              "access": {
                "const": "manual-only"
              }
            }
          }
        }
      ]
    },
    "external_version_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "normalized_url_sha256",
        "status",
        "evidence"
      ],
      "properties": {
        "schema_version": {
          "const": "external-version-evidence.v1"
        },
        "normalized_url_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "status": {
          "enum": [
            "confirmed",
            "unversioned"
          ]
        },
        "evidence": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "material_id",
                "sha256"
              ],
              "properties": {
                "kind": {
                  "const": "local_snapshot"
                },
                "material_id": {
                  "type": "string",
                  "pattern": "^MAT-[0-9]+$"
                },
                "sha256": {
                  "$ref": "#/$defs/sha256"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "provider",
                "revision"
              ],
              "properties": {
                "kind": {
                  "const": "immutable_revision"
                },
                "provider": {
                  "enum": [
                    "git",
                    "document",
                    "api",
                    "other"
                  ]
                },
                "revision": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "file_key",
                "version_id"
              ],
              "properties": {
                "kind": {
                  "const": "figma_revision"
                },
                "file_key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "version_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "page_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "node_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "node_revision": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "etag",
                "fetched_sha256",
                "fetched_at"
              ],
              "properties": {
                "kind": {
                  "const": "etag_content"
                },
                "etag": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "fetched_sha256": {
                  "$ref": "#/$defs/sha256"
                },
                "fetched_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "confirmed"
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "not": {
                  "type": "null"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "unversioned"
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "file_material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "material_id",
        "source_kind",
        "type",
        "identity_sha256",
        "status",
        "event_id",
        "source_path",
        "stored_path",
        "sha256",
        "size_bytes",
        "media_type"
      ],
      "properties": {
        "material_id": {
          "type": "string",
          "pattern": "^CMAT-[0-9]{3,}$"
        },
        "source_kind": {
          "const": "file"
        },
        "type": {
          "$ref": "#/$defs/material_type"
        },
        "identity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "status": {
          "const": "active"
        },
        "event_id": {
          "$ref": "#/$defs/event_id"
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "stored_path": {
          "type": "string",
          "pattern": "^原始资料/CMAT-[0-9]{3,}$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "external_material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "material_id",
        "source_kind",
        "type",
        "identity_sha256",
        "status",
        "event_id",
        "url",
        "normalized_url_sha256",
        "version_evidence",
        "version_evidence_sha256"
      ],
      "properties": {
        "material_id": {
          "type": "string",
          "pattern": "^CMAT-[0-9]{3,}$"
        },
        "source_kind": {
          "const": "external-reference"
        },
        "type": {
          "$ref": "#/$defs/material_type"
        },
        "identity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "status": {
          "enum": [
            "confirmed",
            "blocked"
          ]
        },
        "event_id": {
          "$ref": "#/$defs/event_id"
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "normalized_url_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "version_evidence": {
          "$ref": "#/$defs/external_version_evidence"
        },
        "version_evidence_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "secret_material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "material_id",
        "source_kind",
        "type",
        "identity_sha256",
        "status",
        "event_id",
        "secret_reference",
        "secret_reference_sha256"
      ],
      "properties": {
        "material_id": {
          "type": "string",
          "pattern": "^CMAT-[0-9]{3,}$"
        },
        "source_kind": {
          "const": "secret-reference"
        },
        "type": {
          "$ref": "#/$defs/material_type"
        },
        "identity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "status": {
          "const": "active"
        },
        "event_id": {
          "$ref": "#/$defs/event_id"
        },
        "secret_reference": {
          "$ref": "#/$defs/secret_reference"
        },
        "secret_reference_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
