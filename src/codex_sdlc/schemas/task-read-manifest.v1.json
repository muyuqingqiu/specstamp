{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task-read-manifest.v1",
  "title": "任务完整读取清单",
  "type": "object",
  "required": [
    "schema_version",
    "requirement_id",
    "task_id",
    "run_number",
    "requirement_root",
    "task_file",
    "task_file_sha256",
    "references",
    "predecessor_outputs",
    "generated_at"
  ],
  "properties": {
    "schema_version": {"const": "task-read-manifest.v1"},
    "requirement_id": {"type": "string", "pattern": "^REQ-[0-9]{3,}$"},
    "task_id": {"type": "string", "pattern": "^T-[0-9]{3,}$"},
    "run_number": {"type": "integer", "minimum": 1},
    "requirement_root": {"$ref": "#/$defs/path"},
    "task_file": {"$ref": "#/$defs/path"},
    "task_file_sha256": {"$ref": "#/$defs/sha256"},
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/reference"}
    },
    "predecessor_outputs": {
      "type": "array",
      "items": {"$ref": "#/$defs/output"}
    },
    "generated_at": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "reference": {
      "type": "object",
      "required": ["id", "path", "locator", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "path": {"$ref": "#/$defs/path"},
        "locator": {"type": "object"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": ["task_id", "path", "locator", "sha256"],
      "properties": {
        "task_id": {"type": "string", "pattern": "^T-[0-9]{3,}$"},
        "path": {"$ref": "#/$defs/path"},
        "locator": {"type": "object"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  }
}
