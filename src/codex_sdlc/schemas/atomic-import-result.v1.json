{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sdlc.atomic-import-result.v1",
  "type": "object",
  "required": [
    "schema",
    "package_key",
    "package_sha256",
    "mapping",
    "duplicate",
    "destination",
    "event_ids",
    "files"
  ],
  "properties": {
    "schema": {
      "const": "sdlc.atomic-import-result.v1"
    },
    "package_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "package_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "mapping": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/formal_id"
      }
    },
    "duplicate": {
      "type": "boolean"
    },
    "destination": {
      "type": "string",
      "minLength": 1
    },
    "event_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^EVT-[0-9]{8}-[0-9]{6,}$"
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "formal_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$"
    }
  }
}
