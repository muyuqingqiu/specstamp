{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "requirement-split.v1",
  "title": "需求拆分合同",
  "type": "object",
  "required": [
    "schema_version",
    "draft_id",
    "producer_run_id",
    "title",
    "background",
    "goal",
    "scope",
    "out_of_scope",
    "user_scenarios",
    "input_material_hashes",
    "global_rules",
    "functional_requirements",
    "open_questions"
  ],
  "properties": {
    "schema_version": {
      "const": "requirement-split.v1"
    },
    "draft_id": {
      "type": "string",
      "pattern": "^DRAFT-[0-9]{3,}$"
    },
    "producer_run_id": {
      "$ref": "#/$defs/non_empty_text"
    },
    "title": {
      "$ref": "#/$defs/non_empty_text"
    },
    "background": {
      "$ref": "#/$defs/plain_text"
    },
    "goal": {
      "$ref": "#/$defs/non_empty_text"
    },
    "scope": {
      "$ref": "#/$defs/text_list"
    },
    "out_of_scope": {
      "$ref": "#/$defs/text_list"
    },
    "user_scenarios": {
      "$ref": "#/$defs/text_list"
    },
    "input_material_hashes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^MAT-[0-9]{3,}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      }
    },
    "global_rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/global_rule"
      }
    },
    "functional_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/functional_requirement"
      }
    },
    "open_questions": {
      "$ref": "#/$defs/text_list"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "client_key": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "plain_text": {
      "type": "string",
      "pattern": "^(?![\\s\\S]*@client:)[\\s\\S]*$"
    },
    "non_empty_text": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*@client:)[\\s\\S]*$"
    },
    "text_list": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/non_empty_text"
      }
    },
    "entity_reference": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^@client:[a-z0-9][a-z0-9._-]{0,127}$"
        },
        {
          "type": "string",
          "pattern": "^(FR|GR|AC)-[0-9]{3,}$"
        }
      ]
    },
    "source_reference": {
      "type": "object",
      "required": [
        "material_id",
        "reference"
      ],
      "properties": {
        "material_id": {
          "type": "string",
          "pattern": "^MAT-[0-9]{3,}$"
        },
        "reference": {
          "type": "object",
          "required": [
            "schema_version",
            "path",
            "sha256",
            "locator"
          ],
          "properties": {
            "schema_version": {
              "const": "reference-locator.v1"
            },
            "path": {
              "$ref": "#/$defs/non_empty_text"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "locator": {
              "type": "object"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "required": [
        "kind",
        "target_ref"
      ],
      "properties": {
        "kind": {
          "enum": [
            "replaces",
            "replaced_by",
            "split_from",
            "split_into",
            "merged_from",
            "merged_into",
            "supersedes",
            "superseded_by"
          ]
        },
        "target_ref": {
          "$ref": "#/$defs/entity_reference"
        }
      },
      "additionalProperties": false
    },
    "global_rule": {
      "type": "object",
      "required": [
        "client_key",
        "title",
        "description",
        "type",
        "applies_to",
        "source_refs",
        "relations"
      ],
      "properties": {
        "client_key": {
          "$ref": "#/$defs/client_key"
        },
        "title": {
          "$ref": "#/$defs/non_empty_text"
        },
        "description": {
          "$ref": "#/$defs/non_empty_text"
        },
        "type": {
          "enum": [
            "fact",
            "rule",
            "constraint",
            "state",
            "security",
            "exception"
          ]
        },
        "applies_to": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/entity_reference"
          }
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/source_reference"
          }
        },
        "relations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relation"
          }
        }
      },
      "additionalProperties": false
    },
    "acceptance_criterion": {
      "type": "object",
      "required": [
        "client_key",
        "owner_fr_ref",
        "operation",
        "expected",
        "pass_standard",
        "source_refs",
        "relations"
      ],
      "properties": {
        "client_key": {
          "$ref": "#/$defs/client_key"
        },
        "owner_fr_ref": {
          "$ref": "#/$defs/entity_reference"
        },
        "operation": {
          "$ref": "#/$defs/non_empty_text"
        },
        "expected": {
          "$ref": "#/$defs/non_empty_text"
        },
        "pass_standard": {
          "$ref": "#/$defs/non_empty_text"
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/source_reference"
          }
        },
        "relations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relation"
          }
        }
      },
      "additionalProperties": false
    },
    "functional_requirement": {
      "type": "object",
      "required": [
        "client_key",
        "title",
        "description",
        "elements",
        "flow",
        "facts",
        "rules",
        "constraints",
        "states_and_exceptions",
        "acceptance_criteria",
        "global_rule_refs",
        "source_refs",
        "material_refs",
        "depends_on",
        "out_of_scope",
        "relations"
      ],
      "properties": {
        "client_key": {
          "$ref": "#/$defs/client_key"
        },
        "title": {
          "$ref": "#/$defs/non_empty_text"
        },
        "description": {
          "$ref": "#/$defs/non_empty_text"
        },
        "elements": {
          "$ref": "#/$defs/text_list"
        },
        "flow": {
          "$ref": "#/$defs/text_list"
        },
        "facts": {
          "$ref": "#/$defs/text_list"
        },
        "rules": {
          "$ref": "#/$defs/text_list"
        },
        "constraints": {
          "$ref": "#/$defs/text_list"
        },
        "states_and_exceptions": {
          "$ref": "#/$defs/text_list"
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/acceptance_criterion"
          }
        },
        "global_rule_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/entity_reference"
          }
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/source_reference"
          }
        },
        "material_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^MAT-[0-9]{3,}$"
          }
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/entity_reference"
          }
        },
        "out_of_scope": {
          "$ref": "#/$defs/text_list"
        },
        "relations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relation"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
