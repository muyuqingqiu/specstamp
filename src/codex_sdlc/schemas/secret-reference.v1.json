{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "secret-reference.v1",
  "title": "秘密引用合同",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "identifier", "access"],
  "properties": {
    "schema_version": {
      "const": "secret-reference.v1"
    },
    "kind": {
      "enum": ["environment-variable", "keychain-item", "manual-provision"]
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:/@-]+$"
    },
    "access": {
      "enum": ["runtime-only", "manual-only"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {"const": "environment-variable"}
        }
      },
      "then": {
        "properties": {
          "identifier": {"pattern": "^[A-Z_][A-Z0-9_]*$"},
          "access": {"const": "runtime-only"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {"const": "manual-provision"}
        }
      },
      "then": {
        "properties": {
          "access": {"const": "manual-only"}
        }
      }
    }
  ]
}
