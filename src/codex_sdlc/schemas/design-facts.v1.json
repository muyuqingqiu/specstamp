{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sdlc.design-facts.v1",
  "x-codex-sdlc-hash-exclude": [
    "/artifact_sha256"
  ],
  "type": "object",
  "required": [
    "schema",
    "semantic",
    "semantic_sha256",
    "context_targets",
    "bindings",
    "producer",
    "coverage",
    "artifact_sha256"
  ],
  "properties": {
    "schema": {
      "const": "sdlc.design-facts.v1"
    },
    "draft_id": {
      "type": "string",
      "pattern": "^DRAFT-[0-9]{3,}$"
    },
    "semantic": {
      "$ref": "#/$defs/semantic"
    },
    "semantic_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "context_targets": {
      "type": "object",
      "required": [
        "source_projection_sha256",
        "source_index_sha256",
        "requirement_source_sha256",
        "design_source_sha256",
        "questions_sha256",
        "decisions_sha256",
        "context_inputs_sha256"
      ]
    },
    "bindings": {
      "type": "object",
      "required": [
        "origin_refs",
        "formal_refs"
      ],
      "properties": {
        "origin_refs": {
          "type": "array"
        },
        "formal_refs": {
          "type": "array"
        }
      },
      "additionalProperties": false
    },
    "producer": {
      "type": "object",
      "required": [
        "kind",
        "actor_id",
        "run_id"
      ]
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "unit_id",
          "fact_ids",
          "status",
          "reason"
        ],
        "properties": {
          "unit_id": {
            "type": "string"
          },
          "fact_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "covered",
              "non_contractual",
              "ambiguous"
            ]
          },
          "reason": {
            "type": "string"
          },
          "decision_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "approval_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "artifact_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fact": {
      "type": "object",
      "required": [
        "fact_id",
        "category",
        "owner",
        "statement",
        "normalized",
        "certainty",
        "source_refs",
        "decision_refs",
        "ambiguity_id"
      ],
      "properties": {
        "fact_id": {
          "type": "string",
          "pattern": "^DF-[0-9]{4,}$"
        },
        "category": {
          "enum": [
            "module",
            "interface_implementation",
            "permission_enforcement",
            "state_implementation",
            "data_implementation",
            "error_handling",
            "requirement_coverage",
            "test_strategy",
            "risk"
          ]
        },
        "owner": {
          "const": "design"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "normalized": {
          "type": "object"
        },
        "certainty": {
          "enum": [
            "confirmed",
            "ambiguous",
            "inferred"
          ]
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "decision_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "ambiguity_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "category": {
                "const": "data_implementation"
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "properties": {
              "normalized": {
                "type": "object",
                "required": [
                  "change",
                  "entity"
                ],
                "properties": {
                  "change": {
                    "type": "string",
                    "minLength": 1
                  },
                  "entity": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "error_handling"
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "properties": {
              "normalized": {
                "type": "object",
                "required": [
                  "condition",
                  "result"
                ],
                "properties": {
                  "condition": {
                    "type": "string",
                    "minLength": 1
                  },
                  "result": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "interface_implementation"
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "properties": {
              "normalized": {
                "type": "object",
                "required": [
                  "method",
                  "path"
                ],
                "properties": {
                  "method": {
                    "type": "string",
                    "minLength": 1
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "module"
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "properties": {
              "normalized": {
                "type": "object",
                "required": [
                  "module"
                ],
                "properties": {
                  "module": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "permission_enforcement"
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "properties": {
              "normalized": {
                "type": "object",
                "required": [
                  "action",
                  "direction",
                  "resource",
                  "subject"
                ],
                "properties": {
                  "action": {
                    "type": "string",
                    "minLength": 1
                  },
                  "direction": {
                    "type": "string",
                    "minLength": 1
                  },
                  "resource": {
                    "type": "string",
                    "minLength": 1
                  },
                  "subject": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "requirement_coverage"
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "properties": {
              "normalized": {
                "type": "object",
                "required": [
                  "coverage",
                  "design_fact_id",
                  "requirement_fact_id"
                ],
                "properties": {
                  "coverage": {
                    "type": "string",
                    "minLength": 1
                  },
                  "design_fact_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "requirement_fact_id": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "risk"
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "properties": {
              "normalized": {
                "type": "object",
                "required": [
                  "mitigation",
                  "risk"
                ],
                "properties": {
                  "mitigation": {
                    "type": "string",
                    "minLength": 1
                  },
                  "risk": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "state_implementation"
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "properties": {
              "normalized": {
                "type": "object",
                "required": [
                  "from",
                  "to",
                  "trigger"
                ],
                "properties": {
                  "from": {
                    "type": "string",
                    "minLength": 1
                  },
                  "to": {
                    "type": "string",
                    "minLength": 1
                  },
                  "trigger": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "test_strategy"
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "properties": {
              "normalized": {
                "type": "object",
                "required": [
                  "strategy"
                ],
                "properties": {
                  "strategy": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": true
              }
            }
          }
        }
      ]
    },
    "semantic": {
      "type": "object",
      "required": [
        "facts",
        "relations",
        "ambiguities"
      ],
      "properties": {
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "requirement_fact_id",
              "design_fact_id"
            ],
            "properties": {
              "type": {
                "enum": [
                  "implements",
                  "mitigates",
                  "verifies"
                ]
              },
              "requirement_fact_id": {
                "type": "string",
                "pattern": "^RF-[0-9]{4,}$"
              },
              "design_fact_id": {
                "type": "string",
                "pattern": "^DF-[0-9]{4,}$"
              }
            },
            "additionalProperties": false
          }
        },
        "ambiguities": {
          "type": "array"
        }
      },
      "additionalProperties": false
    }
  }
}
