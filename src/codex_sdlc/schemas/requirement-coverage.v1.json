{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "requirement-coverage.v1",
  "title": "需求覆盖关系合同",
  "type": "object",
  "required": [
    "schema_version",
    "draft_id",
    "requirement_split_sha256",
    "units"
  ],
  "properties": {
    "schema_version": {
      "const": "requirement-coverage.v1"
    },
    "draft_id": {
      "type": "string",
      "pattern": "^DRAFT-[0-9]{3,}$"
    },
    "requirement_split_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/coverage_unit"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "client_key": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "plain_text": {
      "type": "string",
      "pattern": "^(?![\\s\\S]*@client:)[\\s\\S]*$"
    },
    "non_empty_text": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*@client:)[\\s\\S]*$"
    },
    "entity_reference": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^@client:[a-z0-9][a-z0-9._-]{0,127}$"
        },
        {
          "type": "string",
          "pattern": "^(FR|GR|AC)-[0-9]{3,}$"
        }
      ]
    },
    "source_reference": {
      "type": "object",
      "required": [
        "material_id",
        "reference"
      ],
      "properties": {
        "material_id": {
          "type": "string",
          "pattern": "^MAT-[0-9]{3,}$"
        },
        "reference": {
          "type": "object",
          "required": [
            "schema_version",
            "path",
            "sha256",
            "locator"
          ],
          "properties": {
            "schema_version": {
              "const": "reference-locator.v1"
            },
            "path": {
              "$ref": "#/$defs/non_empty_text"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "locator": {
              "type": "object"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "source_relation": {
      "type": "object",
      "required": [
        "kind",
        "target_ref"
      ],
      "properties": {
        "kind": {
          "enum": [
            "replaces",
            "replaced_by",
            "split_from",
            "split_into",
            "merged_from",
            "merged_into",
            "supersedes",
            "superseded_by"
          ]
        },
        "target_ref": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^@client:[a-z0-9][a-z0-9._-]{0,127}$"
            },
            {
              "type": "string",
              "pattern": "^SRC-[0-9]{3,}$"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "coverage_unit": {
      "type": "object",
      "required": [
        "client_key",
        "source_ref",
        "classification",
        "covered_by",
        "status",
        "reason",
        "decision_refs",
        "relations"
      ],
      "properties": {
        "client_key": {
          "$ref": "#/$defs/client_key"
        },
        "source_ref": {
          "$ref": "#/$defs/source_reference"
        },
        "classification": {
          "enum": [
            "requirement",
            "global_rule",
            "acceptance",
            "constraint",
            "exception",
            "table",
            "diagram",
            "background",
            "out_of_scope",
            "other"
          ]
        },
        "covered_by": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/entity_reference"
          }
        },
        "status": {
          "enum": [
            "covered",
            "background",
            "out_of_scope",
            "needs_user",
            "needs_material",
            "excluded_by_decision"
          ]
        },
        "reason": {
          "$ref": "#/$defs/plain_text"
        },
        "decision_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^DEC-[0-9]{3,}$"
          }
        },
        "relations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/source_relation"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "covered"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "covered_by": {
                "minItems": 1
              },
              "decision_refs": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "covered_by": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "excluded_by_decision"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "decision_refs": {
                "minItems": 1
              },
              "reason": {
                "$ref": "#/$defs/non_empty_text"
              }
            }
          },
          "else": {
            "properties": {
              "decision_refs": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "background"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "classification": {
                "const": "background"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "out_of_scope"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "classification": {
                "const": "out_of_scope"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
