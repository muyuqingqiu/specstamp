{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "design-node-index.v1",
  "type": "object",
  "required": [
    "schema_version",
    "design_path",
    "design_sha256",
    "pages"
  ],
  "properties": {
    "schema_version": {
      "const": "design-node-index.v1"
    },
    "design_path": {
      "type": "string",
      "minLength": 1
    },
    "design_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "page_id",
          "nodes"
        ],
        "properties": {
          "page_id": {
            "type": "string",
            "minLength": 1
          },
          "nodes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "node_id"
              ],
              "properties": {
                "node_id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
