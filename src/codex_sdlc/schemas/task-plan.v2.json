{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task-plan.v2",
  "title": "任务计划合同",
  "oneOf": [
    {
      "$ref": "#/$defs/submission"
    },
    {
      "$ref": "#/$defs/record"
    }
  ],
  "$defs": {
    "client_key": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "temporary_task_ref": {
      "type": "string",
      "pattern": "^@client:[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "submission_dependency_ref": {
      "type": "string",
      "pattern": "^(?:@client:[a-z0-9][a-z0-9._-]{0,127}|T-[0-9]{3,})$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^T-[0-9]{3,}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "input_hashes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      }
    },
    "code_evidence": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object"
        }
      ]
    },
    "submission_dependency": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/submission_dependency_ref"
        },
        "to": {
          "$ref": "#/$defs/temporary_task_ref"
        }
      },
      "additionalProperties": false
    },
    "record_dependency": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/task_id"
        },
        "to": {
          "$ref": "#/$defs/task_id"
        }
      },
      "additionalProperties": false
    },
    "submission": {
      "type": "object",
      "required": [
        "schema_version",
        "requirement_id",
        "tasks",
        "dependencies"
      ],
      "properties": {
        "schema_version": {
          "const": "task-plan.v2"
        },
        "requirement_id": {
          "type": "string",
          "pattern": "^REQ-[0-9]{3,}$"
        },
        "producer_run_id": {
          "type": "string",
          "minLength": 1
        },
        "input_hashes": {
          "$ref": "#/$defs/input_hashes"
        },
        "code_evidence": {
          "$ref": "#/$defs/code_evidence"
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/temporary_task_ref"
          }
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/submission_dependency"
          }
        }
      },
      "additionalProperties": false
    },
    "record": {
      "type": "object",
      "required": [
        "schema_version",
        "requirement_id",
        "producer_run_id",
        "input_hashes",
        "tasks",
        "dependencies",
        "mapping"
      ],
      "properties": {
        "schema_version": {
          "const": "task-plan.v2"
        },
        "requirement_id": {
          "type": "string",
          "pattern": "^REQ-[0-9]{3,}$"
        },
        "producer_run_id": {
          "type": "string",
          "minLength": 1
        },
        "input_hashes": {
          "$ref": "#/$defs/input_hashes"
        },
        "code_evidence": {
          "$ref": "#/$defs/code_evidence"
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/task_id"
          }
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/record_dependency"
          }
        },
        "mapping": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/client_key"
          },
          "additionalProperties": {
            "$ref": "#/$defs/task_id"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
