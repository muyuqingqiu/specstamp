{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-request.v1",
  "type": "object",
  "required": [
    "schema_version",
    "review_id",
    "stage",
    "owner_id",
    "producer_run_id",
    "input_hashes",
    "input_paths",
    "required_checks",
    "created_at",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "review-request.v1"
    },
    "review_id": {
      "type": "string",
      "pattern": "^REV-[0-9]{3,}$"
    },
    "stage": {
      "enum": [
        "requirement_split",
        "integrated_design",
        "task_plan"
      ]
    },
    "owner_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$"
    },
    "producer_run_id": {
      "type": "string",
      "minLength": 1
    },
    "input_hashes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      }
    },
    "input_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_checks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "pending"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
